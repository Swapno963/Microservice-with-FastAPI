# Copy to .env before running Docker Compose. Generate unique values; do not
# reuse these examples or commit your .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-random-token
SECURITY_PASSWORD_SALT=replace-with-a-separate-random-salt
